generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int     @id @default(autoincrement())
  nome      String
  email     String  @unique
  senha     String
  articles  Article[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  descricao String
  articles  Article[]
  createdAt DateTime @default(now())
}

model Tag {
  id           Int           @id @default(autoincrement())
  nome         String        @unique
  articleTags  ArticleTag[]
  createdAt    DateTime      @default(now())
}

model Article {
  id             Int           @id @default(autoincrement())
  titulo         String
  descricao      String?
  conteudo       String
  imagemCapa     String?
  tempoDeLeitura Int?
  status         String        @default("rascunho")
  visualizacoes  Int           @default(0)
  autor          User          @relation(fields: [autorId], references: [id])
  autorId        Int
  categoria      Category      @relation(fields: [categoriaId], references: [id])
  categoriaId    Int
  articleTags    ArticleTag[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ArticleTag {
  id        Int     @id @default(autoincrement())
  artigo    Article @relation(fields: [artigoId], references: [id])
  artigoId  Int
  tag       Tag     @relation(fields: [tagId], references: [id])
  tagId     Int
}